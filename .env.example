# Local development settings for docker compose.
# Copy this file to `.env` (which git ignores) and set your own password.
# Use letters and digits only: the password is placed inside a connection string.

POSTGRES_PASSWORD=change-me

# Signs the access tokens. At least 32 characters, random, never shared. One way to make one:
#   powershell -c "$b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
JWT_SIGNING_KEY=

# Encrypts the IBANs stored in the database (ADR 0019): exactly 32 random bytes in base64. Losing
# it loses every stored IBAN, so keep a copy outside the server, apart from the database backups.
# One way to make one:
#   powershell -c "$b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
IBAN_ENCRYPTION_KEY=

# Owner accounts (ADR 0026), created or given their missing numbers when the API starts; a
# number switched off in the panel stays off. The owner logs in with either of his two numbers,
# on two separate phones, so a stolen phone's number can be switched off while he keeps working.
# The developer's account has one number, so nobody can switch it off from the panel. Real
# numbers go only in the server's .env, never in the repository. In Development the login code
# is not sent by SMS; it is shown on the login page and written to the API log and Seq.
#
# To change a number (a new SIM, or the developer's phone stolen): put the new one in the empty
# slot of the same account (OWNER_MOBILE_3 or DEVELOPER_MOBILE_2) and restart; log in with it;
# switch the old one off in «کاربران» (every session of the account ends, the thief's too); later
# move the new number into the first slot and empty the other. Never type the new number over the old one: the account
# would not be recognised, a new one would be made, and the old one could still log in.
OWNER_FULL_NAME=
OWNER_MOBILE=
OWNER_MOBILE_2=
OWNER_MOBILE_3=
DEVELOPER_FULL_NAME=
DEVELOPER_MOBILE=
DEVELOPER_MOBILE_2=

# Host ports. 5432 is often taken by another PostgreSQL, so Yalfan uses 5433.
POSTGRES_PORT=5433
API_PORT=8080
# Seq (development logs): web UI and ingestion, http://localhost:5342. 5341 is often taken.
SEQ_PORT=5342
