{
  "openapi": "3.1.1",
  "info": {
    "title": "Yalfan panel API",
    "version": "v1"
  },
  "paths": {
    "/panel/auth/otp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestLoginCodeCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginCodeRequested"
                }
              }
            }
          }
        }
      }
    },
    "/panel/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/panel/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/panel/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/panel/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSummary"
                }
              }
            }
          }
        }
      }
    },
    "/panel/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStaffUserCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateStaffUserResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateStaffUserCommand": {
        "required": [
          "fullName",
          "mobileNumber",
          "role"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "type": [
              "null",
              "string"
            ]
          },
          "mobileNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          }
        }
      },
      "CreateStaffUserResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginCodeRequested": {
        "required": [
          "expiresInSeconds",
          "resendAfterSeconds"
        ],
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "resendAfterSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginCommand": {
        "required": [
          "mobileNumber",
          "code"
        ],
        "type": "object",
        "properties": {
          "mobileNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RequestLoginCodeCommand": {
        "required": [
          "mobileNumber"
        ],
        "type": "object",
        "properties": {
          "mobileNumber": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Role": {
        "enum": [
          "owner",
          "manager",
          "operator"
        ]
      },
      "SessionResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        }
      },
      "UserSummary": {
        "required": [
          "id",
          "fullName",
          "mobileNumber",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "mobileNumber": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Users"
    }
  ]
}
