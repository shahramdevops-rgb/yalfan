<Project Sdk="Microsoft.NET.Sdk">

  <!-- xunit.v3 test projects are executables that run on Microsoft.Testing.Platform
       (see "test" in global.json). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Yalfan.Domain.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yalfan.Domain\Yalfan.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
