root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,slnx,json,yml,yaml}]
indent_size = 2

# The panel and, later, the store. Prettier reads these values too (ADR 0015).
[*.{ts,tsx,js,mjs,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C# code checks, enforced by the build (warnings are errors) and by `dotnet format` (ADR 0015).
[*.cs]
# Every hand-written file already follows these; the build keeps it that way.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0161.severity = warning # file-scoped namespace
dotnet_diagnostic.IDE0011.severity = warning # braces on every if, else, for, while
dotnet_diagnostic.IDE0044.severity = warning # field could be readonly
dotnet_diagnostic.IDE0051.severity = warning # unused private member
dotnet_diagnostic.IDE0052.severity = warning # private member written but never read
dotnet_diagnostic.IDE0060.severity = warning # unused parameter

# CA1716 warns when a name is a keyword in another .NET language (here `Error`, a Visual Basic
# keyword). The solution is C# only.
dotnet_diagnostic.CA1716.severity = none

# Test names read as Method_Situation_Result on purpose, so underscores are allowed there.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Migrations are generated by `dotnet ef` and regenerated with every model change, so neither
# the formatter nor the analyzers judge them (EF writes them with a BOM and its own style).
[src/Yalfan.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
